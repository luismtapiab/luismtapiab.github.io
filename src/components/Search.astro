---
---

<div id="search-modal" class="search-modal">
  <div class="search-modal-content">
    <div class="search-modal-header">
      <h2>Search</h2>
      <button id="close-search" class="close-search">&times;</button>
    </div>
    <div id="search" class="search-container"></div>
  </div>
</div>

<script is:inline>
  let pagefindReady = null;

  function loadPagefind() {
    if (pagefindReady) return pagefindReady;

    pagefindReady = new Promise((resolve) => {
      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = () => resolve();
      document.head.appendChild(script);
    });

    return pagefindReady;
  }

  function closeSearch() {
    const modal = document.getElementById('search-modal');
    if (modal) {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }
  }

  window.openSearch = async () => {
    const modal = document.getElementById('search-modal');
    if (!modal) return;

    modal.classList.add('open');
    document.body.style.overflow = 'hidden';

    await loadPagefind();

    if (!document.querySelector('#search .pagefind-ui')) {
      new PagefindUI({
        element: "#search",
        showSubResults: true,
        translations: {
          placeholder: "Search posts, projects..."
        }
      });
    }

    setTimeout(() => {
      const input = document.querySelector('.pagefind-ui__search-input');
      if (input) input.focus();
    }, 100);
  };

  if (!window.__searchListenersAttached) {
    window.__searchListenersAttached = true;

    document.addEventListener('click', (e) => {
      if (e.target.id === 'close-search') closeSearch();
      if (e.target.id === 'search-modal') closeSearch();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSearch();
    });
  }
</script>

<style is:global>
  :root {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--accent-alt);
    --pagefind-ui-font: inherit;
  }

  .search-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 1000;
    padding: 2rem 1rem;
  }

  .search-modal.open {
    display: block;
  }

  .search-modal-content {
    background: var(--bg);
    max-width: 600px;
    margin: 0 auto;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border);
    max-height: 80vh;
    overflow-y: auto;
  }

  .search-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .search-modal-header h2 {
    margin: 0;
    font-size: 1.2rem;
  }

  .close-search {
    background: none;
    border: none;
    font-size: 1.5rem;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.2em;
    line-height: 1;
  }

  .close-search:hover {
    color: var(--accent);
  }

  #search .pagefind-ui__search-input {
    background-color: var(--bg-offset);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  #search .pagefind-ui__search-clear {
    background: var(--bg-offset);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  #search .pagefind-ui__result {
    border: 1px solid var(--border);
    background: var(--bg-offset);
    border-radius: 8px;
    padding: 1rem;
  }

  #search .pagefind-ui__result-title,
  #search .pagefind-ui__result-link {
    color: var(--accent) !important;
  }

  #search .pagefind-ui__result-excerpt {
    color: var(--text);
  }

  #search .pagefind-ui__result-anchor {
    color: var(--accent) !important;
  }

  #search mark {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--text);
  }

  #search .pagefind-ui__message {
    color: var(--text-muted);
  }

  #search .pagefind-ui__button {
    background: var(--bg-offset);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  #search .pagefind-ui__button:hover {
    background: var(--surface);
    color: var(--text);
  }

  [data-theme='dark'] #search .pagefind-ui__search-input {
    background-color: #000;
    color: #fdf5e6;
    border-color: #333;
  }

  [data-theme='dark'] .search-modal-content {
    background: #000;
    border-color: #333;
  }

  [data-theme='dark'] #search .pagefind-ui__result {
    background: #111;
    border-color: #333;
  }

  [data-theme='dark'] #search .pagefind-ui__result-title,
  [data-theme='dark'] #search .pagefind-ui__result-link {
    color: #e07a60 !important;
  }

  [data-theme='dark'] #search .pagefind-ui__result-excerpt {
    color: #ddd;
  }

  [data-theme='dark'] #search .pagefind-ui__result-anchor {
    color: #e07a60 !important;
  }

  [data-theme='dark'] #search .pagefind-ui__search-clear {
    background: #222;
    border-color: #444;
    color: #aaa;
  }

  [data-theme='dark'] #search .pagefind-ui__button {
    background: #222;
    border-color: #444;
    color: #aaa;
  }

  [data-theme='dark'] #search .pagefind-ui__button:hover {
    background: #333;
    color: #fff;
  }

  [data-theme='dark'] #search .pagefind-ui__message {
    color: #999;
  }
</style>
